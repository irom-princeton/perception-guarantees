ninja_required_version = 1.3
cxx = /usr/bin/g++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/zm2074/Documents/anaconda3/envs/pac-perception/include -fPIC -O2 -isystem /home/zm2074/Documents/anaconda3/envs/pac-perception/include -fPIC -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/TH -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/include/python3.9 -c
post_cflags = -O2 -I/home/zm2074/Projects/perception-guarantees/third_party/pointnet2/_ext_src/include -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1016"' -DTORCH_EXTENSION_NAME=_ext -D_GLIBCXX_USE_CXX11_ABI=1 -std=c++17
cuda_cflags = -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/TH -I/home/zm2074/Documents/anaconda3/envs/pac-perception/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/zm2074/Documents/anaconda3/envs/pac-perception/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -I/home/zm2074/Projects/perception-guarantees/third_party/pointnet2/_ext_src/include -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1016"' -DTORCH_EXTENSION_NAME=_ext -D_GLIBCXX_USE_CXX11_ABI=1 -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -ccbin /usr/bin/gcc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





